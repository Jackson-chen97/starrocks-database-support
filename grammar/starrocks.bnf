  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=query_recover
}
query_table_expression ::= from_clause_guarded? where_clause_guarded? group_by_clause_guarded? having_clause_guarded? qualify_clause_guarded? window_clause_guarded? {
  elementType="SQL_TABLE_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private from_clause_guarded ::= &"FROM" from_clause
private where_clause_guarded ::= &"WHERE" where_clause
private group_by_clause_guarded ::= &"GROUP" group_by_clause
private having_clause_guarded ::= &"HAVING" having_clause
private qualify_clause_guarded ::= &"QUALIFY" qualify_clause
private window_clause_guarded ::= &"WINDOW" window_clause
private order_by_clause_guarded ::= &"ORDER" order_by_clause
private limit_clause_guarded ::= &"LIMIT" limit_clause
select_clause ::= "SELECT" select_modifier* select_item ("," select_item)* {
  elementType="SQL_SELECT_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=select_recover
}
private select_modifier ::= "ALL" | "DISTINCT"
private select_recover ::= !(";" | ")" | "FROM" | "WHERE" | "GROUP" | "HAVING" | "QUALIFY" | "WINDOW" | "ORDER" | "LIMIT" | "UNION" | "INTERSECT" | "EXCEPT" | "MINUS")
private select_item ::= select_all | select_target
private select_target ::= value_expression select_alias_definition?
select_all ::= (qualified_column_prefix ".")? "*" {
  elementType="SQL_COLUMN_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
left select_alias_definition ::= explicit_select_alias | implicit_select_alias {
  elementType="SQL_AS_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private explicit_select_alias ::= "AS" (identifier_reference | string_literal) {
  pin=1
}
private implicit_select_alias ::= !select_alias_boundary (identifier_reference | string_literal)
private select_alias_boundary ::= "FROM" | "WHERE" | "GROUP" | "HAVING" | "QUALIFY" | "WINDOW" | "ORDER" | "LIMIT" | "UNION" | "INTERSECT" | "EXCEPT" | "MINUS"

from_clause ::= "FROM" table_source {
  elementType="SQL_FROM_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=from_recover
}
private from_recover ::= !(";" | "," | ")" | "JOIN" | "STRAIGHT_JOIN" | "INNER" | "LEFT" | "RIGHT" | "FULL" | "CROSS" | "NATURAL" | "SEMI" | "ANTI" | "WHERE" | "GROUP" | "HAVING" | "QUALIFY" | "WINDOW" | "ORDER" | "LIMIT" | "UNION" | "INTERSECT" | "EXCEPT" | "MINUS")
private table_source ::= &joined_table_start join_expression | table_factor
private joined_table_start ::= table_factor &join_expression_tail_start
private table_factor ::= table_as_expression | table_factor_base
table_as_expression ::= table_factor_base table_alias_clause {
  elementType="SQL_AS_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private table_factor_base ::= lateral_table_factor
  | table_function_call
  | table_reference
  | derived_query_table
  | parenthesized_join_table
private lateral_table_factor ::= "LATERAL" table_function_call
private derived_query_table ::= &parenthesized_query_start parenthesized_query_expression
private parenthesized_query_start ::= "(" ("SELECT" | "WITH" | "VALUES")
private parenthesized_join_table ::= &parenthesized_join_start parenthesized_join_expression
private parenthesized_join_start ::= "(" !("SELECT" | "WITH" | "VALUES")
private join_expression_tail_guarded ::= &join_expression_tail_start join_expression_tail
private join_expression_tail_start ::= join_operator_start | ","
private join_operator_start ::= "JOIN" | "STRAIGHT_JOIN" | "INNER" | "LEFT" | "RIGHT" | "FULL" | "CROSS" | "NATURAL" | "SEMI" | "ANTI"
parenthesized_join_expression ::= "(" table_source ")" {
  elementType="SQL_PARENTHESIZED_JOIN_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
join_expression ::= table_factor join_expression_tail_guarded+ {
  elementType="SQL_JOIN_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=from_recover
}
private join_expression_tail ::= join_operator table_factor join_condition_clause? | "," table_factor
private join_operator ::= ("INNER" | "LEFT" ("OUTER" | "SEMI" | "ANTI")? | "RIGHT" ("OUTER" | "SEMI" | "ANTI")? | "FULL" "OUTER"? | "CROSS" | "NATURAL" | "SEMI" | "ANTI")? ("JOIN" | "STRAIGHT_JOIN")
join_condition_clause ::= "ON" value_expression | using_clause {
  elementType="SQL_JOIN_CONDITION_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
using_clause ::= "USING" "(" column_reference ("," column_reference)* ")" {
