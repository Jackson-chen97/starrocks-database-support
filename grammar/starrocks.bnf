{
  parserClass="com.jc.starrocks.datagrip.lang.StarRocksGeneratedParser"
  parserUtilClass="com.jc.starrocks.datagrip.lang.StarRocksParserUtil"
  elementTypeHolderClass="com.jc.starrocks.datagrip.lang.StarRocksElementTypes"
  tokenTypeClass="com.intellij.sql.psi.SqlTokens"
  tokenTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.token"
  elementTypeFactory(".*")="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  extends("union_expression|intersect_expression|simple_query_expression")=sql_query_expression
  generatePsi=false
}

script ::= statement? (statement_separator statement?)* <<eof>>
private statement_separator ::= ";"

statement ::= dml_statement | ddl_statement | other_statement {
  pin=1
  recoverWhile=statement_recover
}

private statement_recover ::= !(";" | ddl_statement_start | dml_statement_start | other_statement_start)
private ddl_statement_start ::= "CREATE" | "ALTER" | "DROP" | "TRUNCATE" | "REFRESH" | "GRANT" | "REVOKE"
private dml_statement_start ::= "SELECT" | "WITH" | "VALUES" | "INSERT" | "UPDATE" | "DELETE" | "MERGE" | "("
private other_statement_start ::= "SHOW" | "ADMIN" | "ANALYZE" | "SET" | "UNSET" | "KILL" | "SYNC" | "CALL" | "BEGIN" | "START" | "COMMIT" | "ROLLBACK" | "USE" | "EXPLAIN" | "DESC" | "DESCRIBE" | "LOAD" | "CANCEL" | "SUBMIT" | "EXPORT" | "BACKUP" | "RESTORE" | "RECOVER"

ddl_statement ::= create_statement | alter_statement | drop_statement | truncate_table_statement | refresh_materialized_view_statement | grant_statement | revoke_statement

create_statement ::= create_materialized_view_guarded
  | create_view_guarded
  | create_table_guarded
  | create_catalog_guarded
  | create_resource_guarded
  | create_routine_load_guarded
  | create_repository_guarded
  | create_principal_guarded
  | create_schema_guarded
  | create_index_guarded

private create_materialized_view_guarded ::= &create_materialized_view_start create_materialized_view_statement
private create_materialized_view_start ::= "CREATE" "MATERIALIZED" "VIEW"
private create_view_guarded ::= &create_view_start create_view_statement
private create_view_start ::= "CREATE" (("OR" "REPLACE")? "VIEW")
private create_table_guarded ::= &create_table_start create_table_statement
private create_table_start ::= "CREATE" table_scope? "TABLE"
private create_catalog_guarded ::= &create_catalog_start create_catalog_statement
private create_catalog_start ::= "CREATE" "EXTERNAL"? "CATALOG"
private create_resource_guarded ::= &create_resource_start create_resource_statement
private create_resource_start ::= "CREATE" "EXTERNAL"? "RESOURCE"
private create_routine_load_guarded ::= &("CREATE" "ROUTINE" "LOAD") create_routine_load_statement
private create_repository_guarded ::= &("CREATE" "REPOSITORY") create_repository_statement
private create_principal_guarded ::= &("CREATE" ("USER" | "ROLE")) create_principal_statement
private create_schema_guarded ::= &("CREATE" ("DATABASE" | "SCHEMA")) create_schema_statement
private create_index_guarded ::= &("CREATE" "BITMAP"? "INDEX") create_index_statement

create_table_statement ::= "CREATE" table_scope? "TABLE" if_not_exists? table_reference create_table_body {
  elementType="SQL_CREATE_TABLE_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

private create_table_body ::= &"LIKE" like_table_clause
  | table_column_list? create_table_clause* create_table_source?
private create_table_source ::= &"LIKE" like_table_clause | &"AS" as_select_clause

like_table_clause ::= "LIKE" table_reference {
  elementType="SQL_LIKE_TABLE_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}

private table_scope ::= "EXTERNAL" "TEMPORARY"? | "TEMPORARY" "EXTERNAL"?
private if_not_exists ::= "IF" "NOT" "EXISTS"
private if_exists ::= "IF" "EXISTS"

private create_table_clause ::= engine_clause
  | key_model_clause
  | partition_clause
  | distribution_clause
  | buckets_clause
  | comment_clause
  | properties_clause
  | rollup_clause
  | table_order_by_clause

private clause_recover ::= !(";" | "ENGINE" | "PRIMARY" | "DUPLICATE" | "UNIQUE" | "AGGREGATE" | "COMMENT" | "PARTITION" | "DISTRIBUTED" | "BUCKETS" | "REFRESH" | "PROPERTIES" | "ROLLUP" | "ORDER" | "FROM" | "LIKE" | "AS")

engine_clause ::= "ENGINE" "="? engine_name {
  pin=1
  recoverWhile=clause_recover
}
private engine_name ::= "OLAP" | "MYSQL" | "ELASTICSEARCH" | "HIVE" | "HUDI" | "ICEBERG" | "JDBC"

key_model_clause ::= key_model "KEY" key_column_list {
  pin=2
  recoverWhile=clause_recover
}
private key_model ::= "PRIMARY" | "DUPLICATE" | "UNIQUE" | "AGGREGATE"

partition_clause ::= "PARTITION" "BY" partition_expression partition_definition_list? {
  pin=2
  recoverWhile=clause_recover
}
partition_expression ::= partition_method_expression | function_call | parenthesized_value_expression | column_reference
private partition_method_expression ::= ("RANGE" | "LIST") "(" column_reference ("," column_reference)* ")"
partition_definition_list ::= "(" (partition_definition ("," partition_definition)* | range_partition_bounds) ")"
partition_definition ::= "PARTITION" partition_reference "VALUES" partition_values {
  elementType="SQL_PARTITION_DEFINITION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
partition_reference ::= identifier_reference {
  elementType="SQL_PARTITION_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private partition_values ::= "IN" parenthesized_value_expression
  | "LESS" "THAN" partition_upper_bound
  | fixed_partition_range
private partition_upper_bound ::= "MAXVALUE" | parenthesized_value_expression
private fixed_partition_range ::= "[" partition_bound "," partition_bound ")"
private partition_bound ::= "MAXVALUE" | parenthesized_value_expression
private range_partition_bounds ::= "START" parenthesized_value_expression "END" parenthesized_value_expression "EVERY" "(" (interval_expression | value_expression) ")"

distribution_clause ::= "DISTRIBUTED" "BY" distribution_expression buckets_clause? {
  pin=2
  recoverWhile=clause_recover
}
distribution_expression ::= "HASH" "(" column_reference ("," column_reference)* ")" | "RANDOM" | function_call

buckets_clause ::= "BUCKETS" numeric_literal? {
  pin=1
  recoverWhile=clause_recover
}

comment_clause ::= "COMMENT" string_literal {
  pin=1
  recoverWhile=clause_recover
}

properties_clause ::= "PROPERTIES" property_list {
  pin=1
  recoverWhile=clause_recover
}
property_list ::= "(" property_pair ("," property_pair)* ","? ")"
property_pair ::= property_key "=" property_value
property_key ::= string_literal | identifier_reference
property_value ::= string_literal | numeric_literal | keyword_literal | identifier_reference

rollup_clause ::= "ROLLUP" "(" rollup_definition ("," rollup_definition)* ")" {
  pin=1
  recoverWhile=clause_recover
}
private rollup_definition ::= identifier_reference key_column_list rollup_from_clause? rollup_properties_clause?
private rollup_from_clause ::= "FROM" identifier_reference
private rollup_properties_clause ::= "PROPERTIES" property_list

table_order_by_clause ::= "ORDER" "BY" key_column_list {
  pin=2
  recoverWhile=clause_recover
}

materialized_view_order_by_clause ::= "ORDER" "BY" key_column_list {
  pin=2
  recoverWhile=clause_recover
}

create_view_statement ::= "CREATE" ("OR" "REPLACE")? "VIEW" if_not_exists? view_reference view_column_list? comment_clause? as_select_clause {
  elementType="SQL_CREATE_VIEW_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

create_materialized_view_statement ::= "CREATE" "MATERIALIZED" "VIEW" if_not_exists? materialized_view_reference materialized_view_column_list? materialized_view_options as_select_clause {
  elementType="SQL_CREATE_MATERIALIZED_VIEW_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}
private materialized_view_options ::= materialized_view_option*
private materialized_view_option ::= comment_clause
  | materialized_view_distribution_clause
  | materialized_view_refresh_clause
  | materialized_view_partition_clause
  | materialized_view_order_by_clause
  | properties_clause
materialized_view_distribution_clause ::= "DISTRIBUTED" "BY" "HASH" "(" column_reference ("," column_reference)* ")" buckets_clause? {
  elementType="DISTRIBUTION_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=clause_recover
}
materialized_view_refresh_clause ::= "REFRESH" refresh_moment? refresh_scheme {
  elementType="REFRESH_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=clause_recover
}
materialized_view_partition_clause ::= "PARTITION" "BY" (function_call | column_reference) {
  elementType="PARTITION_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=clause_recover
}
materialized_view_column_list ::= "(" view_column ("," view_column)* ","? ")" {
  elementType="SQL_COLUMN_ALIAS_LIST"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
view_column_list ::= "(" view_column ("," view_column)* ","? ")" {
  elementType="SQL_COLUMN_ALIAS_LIST"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
view_column ::= identifier_reference view_column_comment? {
  elementType="STARROCKS_COLUMN_ALIAS_DEFINITION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private view_column_comment ::= "COMMENT" string_literal
refresh_clause ::= "REFRESH" refresh_moment? refresh_scheme? {
  pin=1
  recoverWhile=clause_recover
}
private refresh_moment ::= "IMMEDIATE" | "DEFERRED"
private refresh_scheme ::= "MANUAL" | "ASYNC" refresh_schedule?
private refresh_schedule ::= refresh_start? refresh_every
private refresh_start ::= "START" parenthesized_value_expression
private refresh_every ::= "EVERY" "(" interval_expression ")"

as_select_clause ::= "AS" embedded_query_expression {
  elementType="SQL_AS_QUERY_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}

create_catalog_statement ::= "CREATE" "EXTERNAL"? "CATALOG" catalog_reference (properties_clause | comment_clause)* {
  elementType="SQL_CREATE_CATALOG_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

create_resource_statement ::= "CREATE" "EXTERNAL"? "RESOURCE" resource_reference properties_clause? {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

create_routine_load_statement ::= "CREATE" "ROUTINE" "LOAD" qualified_identifier "ON" table_reference routine_load_clause* {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}
routine_load_clause ::= columns_clause | properties_clause | from_kafka_clause
columns_clause ::= "COLUMNS" ("TERMINATED" "BY" string_literal)?
from_kafka_clause ::= "FROM" "KAFKA" property_list?

create_repository_statement ::= "CREATE" "REPOSITORY" identifier_reference "WITH" "BROKER" identifier_reference? repository_location_clause? properties_clause? {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

create_principal_statement ::= create_user_guarded | create_role_guarded
private create_user_guarded ::= &("CREATE" "USER") create_user_statement
private create_role_guarded ::= &("CREATE" "ROLE") create_role_statement
create_user_statement ::= "CREATE" "USER" security_principal principal_tail* {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
create_role_statement ::= "CREATE" "ROLE" security_principal principal_tail* {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
private principal_type ::= "USER" | "ROLE"
principal_tail ::= identified_by_clause | default_role_clause | properties_clause | set_principal_comment_clause
identified_by_clause ::= "IDENTIFIED" "BY" value_expression
default_role_clause ::= "DEFAULT" "ROLE" security_principal_list
private set_principal_comment_clause ::= "SET" "COMMENT" string_literal

create_schema_statement ::= "CREATE" ("DATABASE" | "SCHEMA") if_not_exists? schema_reference properties_clause? comment_clause? {
  elementType="SQL_CREATE_SCHEMA_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

create_index_statement ::= "CREATE" "BITMAP"? "INDEX" index_reference index_on_target_clause ("USING" "BITMAP")? properties_clause? comment_clause? {
  elementType="SQL_CREATE_INDEX_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

alter_statement ::= alter_materialized_view_guarded
  | alter_table_guarded
  | alter_view_guarded
  | alter_catalog_guarded
  | alter_resource_guarded
  | alter_schema_guarded
  | alter_principal_guarded
  | alter_routine_load_guarded

private alter_materialized_view_guarded ::= &("ALTER" "MATERIALIZED" "VIEW") alter_materialized_view_statement
private alter_table_guarded ::= &("ALTER" "TABLE") alter_table_statement
private alter_view_guarded ::= &("ALTER" "VIEW") alter_view_statement
private alter_catalog_guarded ::= &("ALTER" "CATALOG") alter_catalog_statement
private alter_resource_guarded ::= &("ALTER" "RESOURCE") alter_resource_statement
private alter_schema_guarded ::= &("ALTER" ("DATABASE" | "SCHEMA")) alter_schema_statement
private alter_principal_guarded ::= &("ALTER" ("USER" | "ROLE")) alter_principal_statement
private alter_routine_load_guarded ::= &("ALTER" "ROUTINE" "LOAD") alter_routine_load_statement

alter_table_statement ::= "ALTER" "TABLE" if_exists? table_reference alter_table_action ("," alter_table_action)* {
  elementType="SQL_ALTER_TABLE_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
alter_table_action ::= rename_action
  | alter_table_comment_action
  | add_partition_action
  | drop_partition_action
  | replace_partition_action
  | modify_partition_action
  | alter_distribution_action
  | add_rollup_action
  | drop_rollup_action
  | add_index_action
  | drop_persistent_index_action
  | drop_index_action
  | add_column_action
  | modify_column_action
  | drop_column_action
  | reorder_columns_action
  | set_properties_action
  | swap_table_action
  | compaction_action

rename_action ::= "RENAME" ("ROLLUP" identifier_reference identifier_reference
  | "PARTITION" partition_reference identifier_reference
  | "COLUMN" column_reference "TO"? identifier_reference
  | "TO"? identifier_reference)
alter_table_comment_action ::= "COMMENT" "="? string_literal

add_partition_action ::= "ADD" ("TEMPORARY"? "PARTITION" if_not_exists? partition_reference "VALUES" partition_values
  | "PARTITIONS" range_partition_bounds) alter_partition_distribution_clause? property_list?
private alter_partition_distribution_clause ::= "DISTRIBUTED" "BY" distribution_expression ("BUCKETS" numeric_literal?)?
drop_partition_action ::= "DROP" ("PARTITIONS" "WHERE" value_expression
  | "TEMPORARY"? "PARTITION" if_exists? partition_reference "FORCE"?)
replace_partition_action ::= "REPLACE" "PARTITION" alter_partition_name_list "WITH" "TEMPORARY" "PARTITION" alter_partition_name_list optional_properties_clause?
modify_partition_action ::= "MODIFY" "PARTITION" alter_partition_selection "SET" property_list
private alter_partition_selection ::= partition_reference | alter_partition_name_list | "(" "*" ")"
private alter_partition_name_list ::= "(" partition_reference ("," partition_reference)* ")"

alter_distribution_action ::= alter_distribution_scope? "DISTRIBUTED" "BY" distribution_expression ("DEFAULT"? "BUCKETS" numeric_literal?)?
private alter_distribution_scope ::= "PARTITIONS" parenthesized_identifier_list

add_column_action ::= add_column_action_item ("," &("ADD" "COLUMN") add_column_action_item)*
private add_column_action_item ::= "ADD" "COLUMN"? add_column_spec optional_alter_column_to_clause? optional_properties_clause?
private add_column_spec ::= column_definition optional_column_position_clause? | "(" column_definition ("," column_definition)* ")"
modify_column_action ::= ("MODIFY" | "CHANGE" | "ALTER") "COLUMN"? (modify_struct_field_action
  | column_definition optional_column_position_clause? optional_alter_column_from_clause? optional_properties_clause?
  | column_reference column_attribute+ optional_column_position_clause? optional_alter_column_from_clause? optional_properties_clause?)
private modify_struct_field_action ::= column_reference ("ADD" "FIELD" struct_field_path type_element optional_column_position_clause?
  | "DROP" "FIELD" struct_field_path)
private struct_field_path ::= identifier_reference (("." identifier_reference) | ("." "[" "*" "]"))*
private column_position_clause ::= "FIRST" | "AFTER" column_reference
private optional_column_position_clause ::= &("FIRST" | "AFTER") column_position_clause
private alter_column_to_clause ::= "TO" identifier_reference
private optional_alter_column_to_clause ::= &"TO" alter_column_to_clause
private alter_column_from_clause ::= "FROM" identifier_reference
private optional_alter_column_from_clause ::= &"FROM" alter_column_from_clause
private optional_properties_clause ::= &"PROPERTIES" properties_clause
drop_column_action ::= "DROP" "COLUMN"? column_reference optional_alter_column_from_clause?
reorder_columns_action ::= table_order_by_clause optional_alter_column_from_clause? optional_properties_clause?

add_rollup_action ::= "ADD" "ROLLUP" rollup_definition ("," rollup_definition)*
drop_rollup_action ::= "DROP" "ROLLUP" drop_rollup_item ("," drop_rollup_item)*
private drop_rollup_item ::= identifier_reference optional_properties_clause?
add_index_action ::= "ADD" index_definition
drop_index_action ::= "DROP" "INDEX" index_reference
drop_persistent_index_action ::= "DROP" "PERSISTENT" "INDEX" "ON" "TABLETS" "(" numeric_literal ("," numeric_literal)* ")"

swap_table_action ::= "SWAP" "WITH" table_reference
set_properties_action ::= "SET" "PROPERTIES"? property_list
compaction_action ::= ("BASE" | "CUMULATIVE")? "COMPACT" compaction_partition_target?
private compaction_partition_target ::= partition_reference | alter_partition_name_list

alter_view_statement ::= "ALTER" "VIEW" view_reference as_select_clause {
  elementType="SQL_ALTER_VIEW_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_materialized_view_statement ::= "ALTER" "MATERIALIZED" "VIEW" materialized_view_reference materialized_view_status? refresh_clause? properties_clause? {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}
private materialized_view_status ::= "ACTIVE" | "INACTIVE" | "SUSPEND" | "RESUME"

alter_catalog_statement ::= "ALTER" "CATALOG" catalog_reference set_properties_action {
  elementType="SQL_ALTER_CATALOG_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_resource_statement ::= "ALTER" "RESOURCE" resource_reference set_properties_action {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_schema_statement ::= "ALTER" ("DATABASE" | "SCHEMA") schema_reference alter_schema_action {
  elementType="SQL_ALTER_SCHEMA_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_principal_statement ::= alter_user_guarded | alter_role_guarded
private alter_user_guarded ::= &("ALTER" "USER") alter_user_statement
private alter_role_guarded ::= &("ALTER" "ROLE") alter_role_statement
alter_user_statement ::= "ALTER" "USER" security_principal principal_tail* {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
alter_role_statement ::= "ALTER" "ROLE" security_principal (set_principal_comment_clause | principal_tail)* {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_routine_load_statement ::= "ALTER" "ROUTINE" "LOAD" identifier_reference routine_load_clause* {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

drop_statement ::= drop_materialized_view_guarded
  | drop_table_guarded
  | drop_view_guarded
  | drop_catalog_guarded
  | drop_resource_guarded
  | drop_repository_guarded
  | drop_schema_guarded
  | drop_index_guarded
  | drop_principal_guarded

private drop_materialized_view_guarded ::= &("DROP" "MATERIALIZED" "VIEW") drop_materialized_view_statement
private drop_table_guarded ::= &("DROP" "TABLE") drop_table_statement
private drop_view_guarded ::= &("DROP" "VIEW") drop_view_statement
private drop_catalog_guarded ::= &("DROP" "CATALOG") drop_catalog_statement
private drop_resource_guarded ::= &("DROP" "RESOURCE") drop_resource_statement
private drop_repository_guarded ::= &("DROP" "REPOSITORY") drop_repository_statement
private drop_schema_guarded ::= &("DROP" ("DATABASE" | "SCHEMA")) drop_schema_statement
private drop_index_guarded ::= &("DROP" "INDEX") drop_index_statement
private drop_principal_guarded ::= &("DROP" ("USER" | "ROLE")) drop_principal_statement

drop_table_statement ::= "DROP" "TABLE" if_exists? table_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_view_statement ::= "DROP" "VIEW" if_exists? view_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_materialized_view_statement ::= "DROP" "MATERIALIZED" "VIEW" if_exists? materialized_view_reference {
  pin=3
  recoverWhile=statement_recover
}
drop_catalog_statement ::= "DROP" "CATALOG" if_exists? catalog_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_resource_statement ::= "DROP" "RESOURCE" if_exists? resource_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_repository_statement ::= "DROP" "REPOSITORY" if_exists? identifier_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_schema_statement ::= "DROP" ("DATABASE" | "SCHEMA") if_exists? schema_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_index_statement ::= "DROP" "INDEX" index_reference "ON" table_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_principal_statement ::= drop_user_guarded | drop_role_guarded
private drop_user_guarded ::= &("DROP" "USER") drop_user_statement
private drop_role_guarded ::= &("DROP" "ROLE") drop_role_statement
drop_user_statement ::= "DROP" "USER" security_principal {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
drop_role_statement ::= "DROP" "ROLE" security_principal {
