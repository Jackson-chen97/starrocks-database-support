}
private refresh_partition_clause ::= "PARTITION" (parenthesized_value_expression | "START" parenthesized_value_expression "END" parenthesized_value_expression)

grant_statement ::= "GRANT" privilege_list "ON" privilege_target "TO" security_principal_list with_grant_option_clause? {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
