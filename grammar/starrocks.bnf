private cancel_load_guarded ::= &("CANCEL" "LOAD") cancel_load_statement
private cancel_refresh_materialized_view_guarded ::= &("CANCEL" "REFRESH" "MATERIALIZED" "VIEW") cancel_refresh_materialized_view_statement
private export_guarded ::= &(("EXPORT" "TABLE") | ("CANCEL" "EXPORT")) export_statement

show_statement ::= "SHOW" (show_alter_materialized_view_clause | show_partitions_clause | show_table_status_clause | show_create_clause | show_schema_scoped_clause | show_generic_clause) {
