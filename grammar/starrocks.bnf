  pin=1
}

sql_query_expression ::= union_expression | intersect_expression | simple_query_expression
union_expression ::= sql_query_expression union_operator sql_query_expression {
  elementType="SQL_UNION_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
intersect_expression ::= sql_query_expression intersect_operator sql_query_expression {
