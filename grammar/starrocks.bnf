private transaction_statement ::= begin_statement | commit_statement | rollback_statement
begin_statement ::= "BEGIN" | "START" "TRANSACTION" {
  elementType="SQL_START_TRANSACTION_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
commit_statement ::= "COMMIT" {
  elementType="SQL_COMMIT_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
rollback_statement ::= "ROLLBACK" {
  elementType="SQL_ROLLBACK_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
use_statement ::= "USE" use_target {
  elementType="SQL_USE_SCHEMA_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
use_target ::= schema_reference {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
explain_statement ::= explain_analyze_statement | explain_query_statement {
  elementType="SQL_EXPLAIN_STATEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
private explain_analyze_statement ::= "EXPLAIN" "ANALYZE" dml_statement
private explain_query_statement ::= "EXPLAIN" ("LOGICAL" | "VERBOSE" | "COSTS")? select_statement
describe_statement ::= ("DESC" | "DESCRIBE") "TABLE"? describe_target column_short_reference? {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
describe_target ::= table_reference {
  elementType="SQL_ON_TARGET_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
set_variable_assignment ::= (variable_reference | identifier_reference) "=" value_expression {
  elementType="SQL_SET_ASSIGNMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
load_statement ::= "LOAD" "LABEL" qualified_identifier "(" load_payload ")" ("WITH" "BROKER")? properties_clause? {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
private load_payload ::= "DATA" "INFILE" "(" string_literal ("," string_literal)* ")" "INTO" "TABLE" table_reference load_data_clause*
private load_data_clause ::= columns_clause | "FORMAT" "AS" string_literal
cancel_load_statement ::= "CANCEL" "LOAD" ("FROM" schema_reference)? where_clause? {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
task_statement ::= "SUBMIT" "TASK" identifier_reference "AS" (refresh_materialized_view_statement | query_expression) {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
export_statement ::= "EXPORT" "TABLE" table_reference "TO" string_literal properties_clause? | "CANCEL" "EXPORT" ("FROM" schema_reference)? where_clause? {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
backup_restore_statement ::= ("BACKUP" | "RESTORE") "SNAPSHOT" qualified_identifier ("TO" | "FROM") identifier_reference ("ON" "(" table_reference ("," table_reference)* ")")? properties_clause?
  | "RECOVER" ("TABLE" | "DATABASE" | "PARTITION" | "REPOSITORY")? identifier_reference {
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}

private value_expression ::= or_expression
private expression_recover ::= !("," | ")" | ";" | "." | "[" | "+" | "-" | "*" | "/" | "%" | "||" | "|" | "&" | "<<" | ">>" | "=" | "<" | ">" | "<=" | ">=" | "<>" | "!=" | "<=>" | "AND" | "OR" | "BETWEEN" | "NOT" | "IN" | "IS" | "LIKE" | "REGEXP" | "RLIKE" | "OVER" | "AS" | "FROM" | "WHERE" | "GROUP" | "HAVING" | "QUALIFY" | "WINDOW" | "ORDER" | "LIMIT" | "UNION" | "INTERSECT" | "EXCEPT" | "MINUS" | "JOIN" | "STRAIGHT_JOIN" | "INNER" | "LEFT" | "RIGHT" | "FULL" | "CROSS" | "NATURAL" | "SEMI" | "ANTI" | "WHEN" | "THEN" | "ELSE" | "END" | "SEPARATOR" | "ASC" | "DESC" | "NULLS" | "ROWS" | "RANGE" | "GROUPS" | "PRECEDING" | "FOLLOWING" | "MICROSECOND" | "MILLISECOND" | "SECOND" | "SECONDS" | "MINUTE" | "MINUTES" | "HOUR" | "HOURS" | "DAY" | "DAYS" | "WEEK" | "MONTH" | "QUARTER" | "YEAR" | SQL_IDENT | SQL_IDENT_DELIMITED | SQL_STRING_TOKEN)
private or_expression ::= and_expression ("OR" and_expression)*
private and_expression ::= not_expression ("AND" not_expression)*
private not_expression ::= "NOT"? comparison_expression
private comparison_expression ::= between_expression | binary_comparison_expression | bitwise_expression
between_expression ::= bitwise_expression "NOT"? "BETWEEN" bitwise_expression "AND" bitwise_expression {
  elementType="SQL_BETWEEN_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
binary_comparison_expression ::= bitwise_expression (comparison_operator bitwise_expression | "NOT" ("LIKE" | "REGEXP" | "RLIKE") bitwise_expression | "NOT"? "IN" in_list_or_subquery) {
  elementType="SQL_BINARY_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private comparison_operator ::= "=" | "<" | ">" | "<=" | ">=" | "<>" | "!=" | "<=>" | "LIKE" | "REGEXP" | "RLIKE" | "IS" "NOT"?
private bitwise_expression ::= additive_expression bitwise_operation*
left bitwise_operation ::= ("|" | "&" | "<<" | ">>") additive_expression {
  elementType="SQL_BINARY_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private additive_expression ::= multiplicative_expression additive_operation*
left additive_operation ::= ("+" | "-" | "||") multiplicative_expression {
  elementType="SQL_BINARY_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private multiplicative_expression ::= unary_expression multiplicative_operation*
left multiplicative_operation ::= ("*" | "/" | "%" | "DIV" | "MOD") unary_expression {
  elementType="SQL_BINARY_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private unary_expression ::= ("+" | "-" | "!" | "~" | "BINARY")* postfix_expression
private postfix_expression ::= (cast_expression_guarded | case_expression_guarded | exists_expression_guarded | interval_expression_guarded | scalar_subquery_guarded | array_literal | function_call | literal | parenthesized_value_expression | variable_reference | column_reference | typed_literal_expression) array_access_tail* field_access_tail*
array_literal ::= "[" (value_expression ("," value_expression)*)? "]" {
  elementType="SQL_ARRAY_LITERAL"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
array_access_tail ::= "[" value_expression "]"
field_access_tail ::= "." identifier_reference
private cast_expression_guarded ::= &"CAST" cast_expression
private case_expression_guarded ::= &"CASE" case_expression
private exists_expression_guarded ::= &"EXISTS" exists_expression
private interval_expression_guarded ::= &"INTERVAL" interval_expression
private scalar_subquery_guarded ::= &parenthesized_query_start parenthesized_query_expression
cast_expression ::= "CAST" "(" value_expression "AS" cast_type ")" {
  elementType="SQL_TYPE_CAST_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=expression_recover
}
case_expression ::= "CASE" value_expression? case_when_clause+ case_else_clause? "END" {
  pin=1
  recoverWhile=expression_recover
}
case_when_clause ::= "WHEN" value_expression "THEN" value_expression
case_else_clause ::= "ELSE" value_expression
exists_expression ::= "EXISTS" "(" query_expression ")"
interval_expression ::= "INTERVAL" value_expression interval_unit
typed_literal_expression ::= typed_literal_prefix literal
function_call ::= function_name ("." function_name)* <<parseFunctionCallTail>> function_null_treatment_clause? analytic_clause_guarded?
  {
    elementType="SQL_FUNCTION_CALL"
    elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  }
function_name ::= identifier_reference | function_keyword {
  elementType="SQL_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
function_keyword ::= <<parseFunctionKeyword>> {
  elementType="SQL_IDENTIFIER"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private function_null_treatment_clause ::= ("IGNORE" | "RESPECT") "NULLS"
parenthesized_value_expression ::= "(" value_expression ("," value_expression)* ")" {
  elementType="SQL_PARENTHESIZED_EXPRESSION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
in_list_or_subquery ::= "(" (in_subquery_guarded | value_expression ("," value_expression)*)? ")"
private in_subquery_guarded ::= &("SELECT" | "WITH" | "VALUES") query_expression
private analytic_clause_guarded ::= &"OVER" analytic_clause
analytic_clause ::= "OVER" (window_reference | "(" window_specification ")") {
  elementType="SQL_ANALYTIC_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
}
window_reference ::= identifier_reference {
  elementType="SQL_WINDOW_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}

type_element ::= scalar_type type_parameters? | complex_type {
  elementType="SQL_TYPE_ELEMENT"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=type_recover
}
cast_type ::= type_element {
  pin=1
  recoverWhile=type_recover
}
private type_recover ::= !("," | ")" | ">" | "KEY" | "NULL" | "NOT" | "DEFAULT" | "COMMENT" | "AUTO_INCREMENT" | "AS" | "AFTER" | "FIRST" | "TO" | "FROM" | "PROPERTIES" | "SUM" | "MAX" | "MIN" | "REPLACE" | "HLL_UNION" | "BITMAP_UNION" | "PERCENTILE_UNION" | "REPLACE_IF_NOT_NULL")
scalar_type ::= "BOOLEAN" | "BOOL" | "TINYINT" | "SMALLINT" | "INT" | "INTEGER" | "BIGINT" | "LARGEINT" | "FLOAT" | "DOUBLE" | "DECIMAL" | "DECIMALV2" | "DECIMAL32" | "DECIMAL64" | "DECIMAL128" | "NUMERIC" | "CHAR" | "VARCHAR" | "VARCHAR2" | "STRING" | "TEXT" | "BINARY" | "VARBINARY" | "DATE" | "DATETIME" | "TIME" | "TIMESTAMP" | "JSON" | "VARIANT" | "BITMAP" | "HLL" | "PERCENTILE"
type_parameters ::= "(" numeric_literal ("," numeric_literal)* ")" {
  elementType="SQL_TYPE_PARAMETER_LIST"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private complex_type ::= array_type | map_type | struct_type
private array_type ::= "ARRAY" array_type_parameters
private map_type ::= "MAP" map_type_parameters
private struct_type ::= "STRUCT" struct_type_parameters
array_type_parameters ::= "<" type_element ">" {
  elementType="SQL_TYPE_PARAMETER_LIST"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
map_type_parameters ::= "<" type_element "," type_element ">" {
  elementType="SQL_TYPE_PARAMETER_LIST"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
struct_type_parameters ::= "<" struct_field ("," struct_field)* ">" {
  elementType="SQL_TYPE_PARAMETER_LIST"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
struct_field ::= identifier_reference ":"? type_element {
  elementType="SQL_COLUMN_DEFINITION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}

table_column_list ::= "(" table_column_item ("," table_column_item)* ","? ")" {
  elementType="SQL_TABLE_ELEMENT_LIST"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=table_column_recover
}
private table_column_recover ::= !(")" | "," | ";" | "INDEX" | "ENGINE" | "PRIMARY" | "DUPLICATE" | "UNIQUE" | "AGGREGATE" | "COMMENT" | "PARTITION" | "DISTRIBUTED" | "BUCKETS" | "PROPERTIES" | "ROLLUP" | "ORDER" | "AS")
private table_column_item ::= column_definition | index_definition | table_constraint
column_definition ::= identifier_reference type_element column_attribute* {
  elementType="SQL_COLUMN_DEFINITION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
column_attribute ::= aggregation_type | "KEY" | "NOT" "NULL" | "NULL" | "DEFAULT" value_expression | "COMMENT" string_literal | key_model "KEY" | "AUTO_INCREMENT" | column_generated_clause
private aggregation_type ::= "SUM" | "MAX" | "MIN" | "REPLACE" | "HLL_UNION" | "BITMAP_UNION" | "PERCENTILE_UNION" | "REPLACE_IF_NOT_NULL"
column_generated_clause ::= "AS" value_expression {
  elementType="SQL_COLUMN_GENERATED_CLAUSE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
}
index_definition ::= "INDEX" index_reference key_column_list ("USING" index_type)? index_comment_clause? {
  elementType="SQL_INDEX_DEFINITION"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=table_column_recover
}
private index_type ::= "BITMAP" | "NGRAMBF" | "GIN" | "VECTOR"
private index_comment_clause ::= "COMMENT" string_literal
table_constraint ::= ("PRIMARY" | "UNIQUE" | "DUPLICATE" | "AGGREGATE") "KEY" key_column_list
key_column_list ::= "(" key_column ("," key_column)* ","? ")"
private key_column ::= column_reference

parenthesized_identifier_list ::= "(" identifier_reference ("," identifier_reference)* ","? ")"
private qualified_identifier ::= identifier_reference ("." identifier_reference)*
identifier_reference ::= identifier | delimited_identifier | quoted_identifier {
  elementType="SQL_IDENTIFIER"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
column_reference ::= (qualified_column_prefix ".")? column_reference_name {
  elementType="SQL_COLUMN_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
qualified_column_prefix ::= identifier_reference "." identifier_reference &"." | identifier_reference &"." {
  elementType="SQL_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private column_reference_name ::= identifier_reference | "COMMENT" | "CONFIG"
table_reference ::= table_reference_name {
  elementType="SQL_TABLE_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private table_reference_name ::= (table_reference_prefix ".")? identifier_reference
table_reference_prefix ::= identifier_reference "." identifier_reference &"." | identifier_reference &"." {
  elementType="SQL_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private view_reference ::= <<parseViewReference>>
private materialized_view_reference ::= <<parseMaterializedViewReference>>
private schema_reference ::= <<parseSchemaReference>>
private catalog_reference ::= <<parseCatalogReference>>
resource_reference ::= qualified_identifier
private index_reference ::= <<parseIndexReference>>

private literal ::= string_literal | numeric_literal | parameter_literal | keyword_literal
string_literal ::= SQL_STRING_TOKEN {
  elementType="SQL_STRING_LITERAL"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
numeric_literal ::= SQL_INTEGER_TOKEN | SQL_FLOAT_TOKEN | leading_dot_numeric_literal {
  elementType="SQL_NUMERIC_LITERAL"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private leading_dot_numeric_literal ::= "." SQL_INTEGER_TOKEN
parameter_literal ::= <<parseParameter>>
variable_reference ::= <<parseVariable>> {
  elementType="STARROCKS_VARIABLE_REFERENCE"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
keyword_literal ::= "TRUE" | "FALSE" | "NULL" | "CURRENT_DATE" | "CURRENT_TIME" | "CURRENT_TIMESTAMP" | "LOCALTIME" | "LOCALTIMESTAMP" {
  elementType="SQL_SPECIAL_LITERAL"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
typed_literal_prefix ::= "DATE" | "DATETIME" | "TIME" | "TIMESTAMP"
interval_unit ::= "MICROSECOND" | "MILLISECOND" | "SECOND" | "SECONDS" | "MINUTE" | "MINUTES" | "HOUR" | "HOURS" | "DAY" | "DAYS" | "WEEK" | "MONTH" | "QUARTER" | "YEAR"

private identifier ::= SQL_IDENT | <<parseOptionalKeyword>> | identifier_keyword
private identifier_keyword ::= "LABEL" | "LOCATION" | "VALUE"
private delimited_identifier ::= SQL_IDENT_DELIMITED
private quoted_identifier ::= SQL_STRING_TOKEN
