  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private union_operator ::= ("UNION" "ALL"?) | "EXCEPT" | "MINUS"
private intersect_operator ::= "INTERSECT"

simple_query_expression ::= select_clause query_table_expression? order_by_clause_guarded? limit_clause_guarded? {
