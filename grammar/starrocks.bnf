private show_partitions_clause ::= "PARTITIONS" ("FROM" | "IN") table_reference show_like_clause?
private show_table_status_clause ::= "TABLE" "STATUS" show_schema_from_clause? show_like_clause?
private show_create_clause ::= "CREATE" show_create_target
private show_schema_scoped_clause ::= show_schema_scoped_target show_schema_from_clause? show_like_clause?
private show_schema_scoped_target ::= "TABLES" | "FUNCTIONS" | "MATERIALIZED" "VIEWS"
private show_schema_from_clause ::= ("FROM" | "IN") schema_reference
private show_generic_clause ::= show_generic_target show_from_clause? show_like_clause?
private show_generic_target ::= "DATABASES" | "SCHEMAS" | "VARIABLES" | "ROLES" | "USERS" | "GRANTS" | "CATALOGS" | "RESOURCES" | "ANALYZE" "STATUS" | "STATS" "META" | "BACKUP" | "RESTORE" | "PROC" value_expression?
private show_from_clause ::= ("FROM" | "IN") qualified_identifier
private show_like_clause ::= "LIKE" string_literal
show_create_target ::= ("TABLE" table_reference) | ("VIEW" view_reference) | ("MATERIALIZED" "VIEW" materialized_view_reference) | ("CATALOG" catalog_reference)

admin_statement ::= "ADMIN" "SHOW" ("FRONTEND" | "FRONTENDS" | "BACKEND" | "BACKENDS" | "BROKER" | "BROKERS") ("CONFIG" | "STATUS")? {
