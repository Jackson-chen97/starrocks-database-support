  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private table_alias_clause ::= "AS"? identifier_reference column_alias_list?
column_alias_list ::= "(" column_alias_definition ("," column_alias_definition)* ","? ")" {
  elementType="SQL_COLUMN_ALIAS_LIST"
  elementTypeFactory="com.jc.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
column_alias_definition ::= identifier_reference {
